generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  role     String   @default("operador") // admin | operador
  criadoEm DateTime @default(now())
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  telefone     String
  endereco     String
  criadoEm     DateTime      @default(now())
  agendamentos Agendamento[]
}

model Profissional {
  id            Int           @id @default(autoincrement())
  nome          String
  email         String        @unique
  telefone      String
  especialidade String        @default("geral") // geral | residencial | comercial
  disponivel    Boolean       @default(true)
  criadoEm      DateTime      @default(now())
  agendamentos  Agendamento[]
}

model Agendamento {
  id             Int      @id @default(autoincrement())
  clienteId      Int
  profissionalId Int
  tipoServico    String // residencial | comercial
  dataHora       DateTime
  duracao        Int // em minutos
  status         String   @default("agendado") // agendado | em_andamento | concluido | cancelado
  observacoes    String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
}
